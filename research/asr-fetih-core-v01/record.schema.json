{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enguru:fetih-core:record:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source_verse",
    "source_text",
    "concept",
    "relationship_type",
    "related_concept",
    "interpretation",
    "verification_status",
    "schema_version",
    "epistemic_level",
    "rule_id",
    "confidence",
    "source_reference"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_verse": {
      "type": "string",
      "pattern": "^48:([1-9]|1[0-9]|2[0-9])$"
    },
    "source_text": {
      "type": "string",
      "minLength": 1
    },
    "concept": {
      "type": "string",
      "minLength": 1
    },
    "relationship_type": {
      "enum": [
        "bağlam",
        "eylem",
        "koşul",
        "süreç"
      ]
    },
    "related_concept": {
      "type": "string",
      "minLength": 1
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    },
    "verification_status": {
      "const": "PENDING_HUMAN_REVIEW"
    },
    "schema_version": {
      "const": "1.0"
    },
    "epistemic_level": {
      "const": "K3"
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_reference": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true
    }
  },
  "description": "Runtime validator additionally verifies exact verse text, rule identity and tafsir range."
}
