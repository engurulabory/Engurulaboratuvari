{
  "schemaVersion": "1.1",
  "name": "REPOSITORY STEWARD Worker Hardening Pass",
  "workerClass": "CORE_WORKER",
  "scopes": ["ENGURU_LABORY", "ENGURU_PRODUCT", "ENGURU_CORE"],
  "cycle": ["YOKLAMA","TERTIP","DUZEN","TEMIZLIK","SADELESTIRME","BAKIM","ONARIM","KAPANIS","YENIDEN_HAZIR"],
